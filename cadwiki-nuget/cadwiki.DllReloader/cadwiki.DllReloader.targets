<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <CadwikiOptionalDll>$(MSBuildThisFileDirectory)cadwiki.AcRemoveCmdGroup.dll</CadwikiOptionalDll>
  </PropertyGroup>

  <Target Name="Cadwiki_CopyOptionalDll" AfterTargets="Build">

    <!-- Copy ONLY if file exists -->
    <Copy
      SourceFiles="$(CadwikiOptionalDll)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(CadwikiOptionalDll)')" />

    <!-- Warn if missing -->
    <Warning
      Condition="!Exists('$(CadwikiOptionalDll)')"
      Text="cadwiki: Optional file cadwiki.AcRemoveCmdGroup.dll not found. Skipping." />

  </Target>

</Project>