    </Reference>
    <Reference Include="AcTcMgd">
      <HintPath>..\_libs\AutoCAD 2024\AcTcMgd.dll</HintPath>
    </Reference>
    <Reference Include="AcWindows">
      <HintPath>..\_libs\AutoCAD 2024\AcWindows.dll</HintPath>
    </Reference>
    <Reference Include="AdUIMgd">
