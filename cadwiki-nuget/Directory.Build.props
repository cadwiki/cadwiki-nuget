<Project>
  <PropertyGroup>
    <NoWarn>168,1591,42016,41999,42017,42018,42019,42032,42036,42020,42021,42022,162,649,1717,219,67,414,4244,414,MSB3270,3270</NoWarn>
    <!-- Required when restoring/building net8.0-windows projects on non-Windows (macOS/Linux) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- ═══════════════════════════════════════════════════════════════════
         Central Versioning Schema — single source of truth for all projects.

         MODES:
           1. Manual (default):  Set CadwikiAutoVersion=false (or omit).
              All four segments come from the explicit properties below.

           2. Auto-increment:    Set CadwikiAutoVersion=true.
		      Minor = yyyy  (UTC date of the build, e.g. 2026)
              Build  = MMdd  (UTC date of the build, e.g. 0503)
              Revision = Hhmm  (UTC time of the build, e.g. 1755)
              → Version becomes  maj.yyyy.MMdd.Hhmm

         In both modes, CadwikiVersionMajor and CadwikiVersionMinor are
         always set explicitly. The computed CadwikiVersion feeds into
         Version, AssemblyVersion, FileVersion, and InformationalVersion
         for all SDK-style projects in this solution.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── Release identity (always set manually) ── -->
    <CadwikiVersionMajor>25</CadwikiVersionMajor>
    <CadwikiVersionMinor>0</CadwikiVersionMinor>

    <!-- ── Auto-increment toggle ── -->
    <!-- Set to true on the command line or in CI to enable timestamp-based versioning:
           msbuild /p:CadwikiAutoVersion=true
           dotnet build /p:CadwikiAutoVersion=true                              -->
    <CadwikiAutoVersion Condition="'$(CadwikiAutoVersion)' == ''">false</CadwikiAutoVersion>

    <!-- ── Manual version segments (used when CadwikiAutoVersion=false) ── -->
    <CadwikiVersionBuild Condition="'$(CadwikiAutoVersion)' != 'true'">0</CadwikiVersionBuild>
    <CadwikiVersionRevision Condition="'$(CadwikiAutoVersion)' != 'true'">7</CadwikiVersionRevision>

    <!-- ── Auto-increment segments (used when CadwikiAutoVersion=true) ──
         Computed from the current UTC timestamp at evaluation time.
         Format: maj.yyyy.MMdd.Hhmm
         Example: 25.2026.0503.1755

         NOTE: These use System.DateTime.UtcNow so the version is
         timezone-independent and always monotonically increasing.

         IMPORTANT: yyyyMMdd produces values like 20260503 and Hhmmss
         produces values like 175530. Both exceed the 16-bit (0-65535)
         limit of .NET Framework's AssemblyVersion segments. This is
         fine for:
           - SDK-style projects (.NET 8+) — System.Version uses Int32
           - NuGet package versions — SemVer strings, no numeric limit
           - InformationalVersion — free-form string
         For legacy .NET Framework 4.8 projects that need strict 16-bit
         AssemblyVersion compatibility, use CadwikiAutoVersion=false
         (the default) and set segments manually.                        -->
    <CadwikiVersionMinor Condition="'$(CadwikiAutoVersion)' == 'true'">$([System.DateTime]::UtcNow.ToString('yyyy'))</CadwikiVersionMinor>
    <CadwikiVersionBuild Condition="'$(CadwikiAutoVersion)' == 'true'">$([System.DateTime]::UtcNow.ToString('MMdd'))</CadwikiVersionBuild>
    <CadwikiVersionRevision Condition="'$(CadwikiAutoVersion)' == 'true'">$([System.DateTime]::UtcNow.ToString('Hhmm'))</CadwikiVersionRevision>

    <!-- ── Composed version string ── -->
    <CadwikiVersion>$(CadwikiVersionMajor).$(CadwikiVersionMinor).$(CadwikiVersionBuild).$(CadwikiVersionRevision)</CadwikiVersion>

    <!-- Feed the SDK-style Version / AssemblyVersion / FileVersion properties -->
    <Version>$(CadwikiVersion)</Version>
    <AssemblyVersion>$(CadwikiVersion)</AssemblyVersion>
    <FileVersion>$(CadwikiVersion)</FileVersion>
    <InformationalVersion>$(CadwikiVersion)</InformationalVersion>
  </PropertyGroup>
  
  <Target Name="CopyDllsToTemp" AfterTargets="Build">

    <!-- Collect all DLLs from the output directory -->
    <ItemGroup>
      <BuiltDlls Include="$(OutputPath)\*.dll" />
    </ItemGroup>

    <!-- Ensure destination exists -->
    <MakeDir Directories="C:\.desktop\cwBuild\_v$(CadwikiVersion)" />

    <!-- Copy DLLs -->
    <Copy
      SourceFiles="@(BuiltDlls)"
      DestinationFolder="C:\.desktop\cwBuild\_v$(CadwikiVersion)"
      SkipUnchangedFiles="true" />

  </Target>
</Project>
