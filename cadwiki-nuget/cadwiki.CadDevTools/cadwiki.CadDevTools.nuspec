<?xml version="1.0" encoding="utf-8"?>
<package >
  <metadata>
    <id>cadwiki.CadDevTools</id>
	<!-- Version is inherited from Directory.Build.props via $version$ token.
	     Pass it when packing: nuget pack ... -properties "version=X.Y.Z"
	     The .targets file now uses $(MSBuildThisFileDirectory) so it no
	     longer needs manual version updates.                               -->
    <version>$version$</version>
    <authors>cadwiki</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <icon>images\500x500-cadwiki-v1.png</icon>
    <projectUrl>https://github.com/cadwiki/cadwiki-nuget</projectUrl>
    <description>Dev toolset</description>
    <releaseNotes>
	</releaseNotes>
    <copyright>$copyright$</copyright>
    <tags>cadwiki dllreload reload assembly autocad appdomain</tags>
    <contentFiles>
        <files include="lib\cadwiki.AcRemoveCmdGroup.dll" buildAction="None" copyToOutput="true" />
    </contentFiles>
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Handlebars.Net" version="2.1.6" />
        <dependency id="Newtonsoft.Json" version="13.0.4" />
        <dependency id="NUnit" version="4.6.0" />
        <dependency id="PDFsharp" version="6.2.4" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <!-- .NET 8 output -->
    <file src="bin\$configuration$\net8.0-windows\*.dll" target="lib\net8.0" />
    <file src="bin\$configuration$\net8.0-windows\*.pdb" target="lib\net8.0" />
	<file src="bin\$configuration$\net8.0-windows\cadwiki.AcRemoveCmdGroup.dll" target="Build"/>
	<file src="cadwiki.CadDevTools.targets" target="Build"/>
	<file src="..\icons\500x500-cadwiki-v1.png" target="images\" />
  </files>
</package>
